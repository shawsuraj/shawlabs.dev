{
  "outputDirectory": "dist",
  "buildCommand": "",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/live/wcm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/wcm",
      "destination": "/world-chaos-map",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/live/wcm",
      "destination": "https://www.worldchaosmap.app/api/map-snapshot"
    }
  ]
}